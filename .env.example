# =========================
# MyAgent configuration
# =========================

# Environment
APP_ENV=development
LOG_LEVEL=INFO

# LLM

# Memory
MEMORY_BACKEND=local
MEMORY_PATH=./data/memory

# Code Graph
CODE_GRAPH_PATH=./data/code_graph

# Sandbox
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT=120

# Tools
ALLOW_TERMINAL=true
ALLOW_FILESYSTEM=true
ALLOW_NETWORK=false

# MCP
MCP_HOST=127.0.0.1
MCP_PORT=8765